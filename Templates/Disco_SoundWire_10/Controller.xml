<?xml version="1.0" ?>
<!-- Version 1.0 -->

<!-- Package describing SoundWire controller properties -->
<Template>

	<!-- Name of the template (the unique identifier for this package) -->
	<Name></Name>

    <Header>
		<!-- Name of the original template this file is based off of -->
		<TemplateType>SDW_Controller</TemplateType>
		<!-- Name of the parent template (empty for starting template) -->
		<Parents></Parents>
		<!-- Template version (increases as user saves intermediate files) -->
		<Version>1</Version>
		<!-- Name of the specification (common between all of the files used for current device) -->
		<Specification>DisCo for Soundwire 1.0</Specification>
		<!-- Template author -->
		<Author>MIPI</Author>
		<!-- Local project path (has a value if this template is the _DSD and is an intermediate file) -->
		<TemplatePath></TemplatePath>
	</Header>

	<!-- List of SoundWire controller properties that do not reference other packages -->
	<Properties>
		<Property>
			<!-- Name of the property -->
			<Name>mipi-sdw-sw-interface-revision</Name>
			<!-- Allowed data type for property value (Integer, String, or Package) -->
			<DataType>Integer</DataType>
			<!-- 0 = Not required, 1 = Required -->
			<Required>1</Required>
			<!-- Property description -->
			<Description>Version of this Specification whose Property definitions apply. This is intended to guard against any potential changes to the property definitions in future versions of this Specification. </Description>
			<!-- 0 = OEM cannot modify, 1= OEM can modify -->
			<OEMModify>0</OEMModify> 
			<!-- Current property value -->
			<Value></Value>
			<!-- Default value for this property if user does not choose one (if absent, there is no default value) -->
			<Default></Default>
			<DependentPackages></DependentPackages>
		</Property>

		<Property>
			<Name>mipi-sdw-master-count</Name>
			<DataType>Integer</DataType>
			<Required>0</Required>
			<Description>If present, this property describes the number of Masters present on this Device. For a Controller where this property is absent, the expected Master count is 1.</Description>
			<OEMModify>0</OEMModify>
			<Value></Value>
			<Default>1</Default>
			<!-- Packages that rely on the value of this property (i.e. this value dictates how many references of the dependent package there will be). If absent, there is no dependent package for this property. -->
			<DependentPackages>
				<Package>
					<!-- Dependent package name -->
					<Name>SDW_Master</Name>
					<!-- Dependent package file name -->
					<Filename>Master.xml</Filename>
					<!-- Dependent package description -->
					<Description>String encoding of a NameString of an object resolving to a package describing properties for each master. The number of these entries shall be equal to the value of mipi-sdw-master-count.</Description>
					<!-- Prefix of the property name used to reference this package -->
					<PropertyNamePrefix>mipi-sdw-master-</PropertyNamePrefix>
					<!-- Postfix of the property name used to reference this package -->
					<PropertyNamePostfix>-subproperties</PropertyNamePostfix>
					<!-- Prefix used to reference package-->
					<PackageNamePrefix>MS</PackageNamePrefix>
					<!-- How this property value should be interpreted when used to name corresponding hierarchical properties -->
					<InterpretValue>Integer</InterpretValue>
					<!-- List of hierarchical properties that were dynamically generated for this package based on the above property value -->
					<HierarchicalProperties>
					</HierarchicalProperties>
				</Package>
			</DependentPackages>
		</Property>
	</Properties>
	
	<!-- List of SoundWire controller properties that do reference other packages but were not dynamically generated based off of another property value -->
	<HierarchicalProperties>
	</HierarchicalProperties>

</Template>